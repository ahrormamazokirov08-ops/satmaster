# Supabase PostgreSQL Connection URL (Transaction Pooler Port 6543 recommended)
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL=postgresql://postgres.your_project_ref:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Telegram Bot Credentials (Obtain from @BotFather, never commit real token)
TELEGRAM_BOT_TOKEN=0000000000:AAExampleTokenPlaceholderForSetup0
ADMIN_CHAT_ID=1234567890
PORT=8080
